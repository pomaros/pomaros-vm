set -eu

usage()
{
    echo "usage: build-abi-probe [--profile cli|tls|workbench|platform|pci|pthread-heap|runtime-context|cpu-widget|usb-desktop|desktop-input|desktop-clipboard|desktop-network|desktop-work|desktop-shutdown|desktop-soak|stage6-transport|stage6-image] [--sdk SDK_ROOT] [--sdk-tools DIR] [--crosstools DIR] OUTPUT" >&2
    exit 2
}

project_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
sdk_root=${AROS_VM_SDK:-"$project_root/../Build/pomaros-vm/reference-core/bin/apple-aarch64"}
sdk_tools=
crosstools=${AROS_CROSSTOOLS:-"$project_root/../aros-crosstools"}
profile=cli

while [ "$#" -gt 0 ]; do
    case "$1" in
        --profile)
            [ "$#" -ge 2 ] || usage
            profile=$2
            shift 2
            ;;
        --sdk)
            [ "$#" -ge 2 ] || usage
            sdk_root=$2
            shift 2
            ;;
        --crosstools)
            [ "$#" -ge 2 ] || usage
            crosstools=$2
            shift 2
            ;;
        --sdk-tools)
            [ "$#" -ge 2 ] || usage
            sdk_tools=$2
            shift 2
            ;;
        --help|-h)
            usage
            ;;
        --*)
            usage
            ;;
        *)
            break
            ;;
    esac
done
[ "$#" -eq 1 ] || usage

case "$profile" in
    runtime-context)
        source_file="$project_root/tests/runtime-context.c"
        ;;
    pthread-heap)
        source_file="$project_root/tests/pthread-heap-lifetime.c"
        ;;
    cpu-widget)
        source_file="$project_root/src/guest/cpu-widget.c"
        ;;
    cli)
        source_file="$project_root/tests/abi-corpus/portable-probe.c"
        ;;
    tls)
        source_file="$project_root/tests/abi-corpus/tls-concurrency-probe.c"
        ;;
    pci)
        source_file="$project_root/tests/pci-hidd-probe.c"
        ;;
    stage6-transport)
        source_file="$project_root/tests/stage6-transport.c"
        ;;
    stage6-image)
        source_file="$project_root/tests/stage6-image.c"
        ;;
    desktop-soak)
        source_file="$project_root/tests/desktop-soak.c"
        ;;
    desktop-work|desktop-shutdown)
        source_file="$project_root/tests/desktop-work.c"
        ;;
    desktop-network)
        source_file="$project_root/tests/network-stack.c"
        ;;
    desktop-clipboard)
        source_file="$project_root/tests/clipboard-sync.c"
        ;;
    desktop-input)
        source_file="$project_root/tests/desktop-input.c"
        ;;
    usb-desktop)
        source_file="$project_root/tests/usb-desktop.c"
        ;;
    platform)
        source_file="$project_root/tests/platform-probe.c"
        ;;
    workbench)
        source_file="$project_root/tests/abi-corpus/workbench-probe.c"
        ;;
    *)
        usage
        ;;
esac

[ -n "$sdk_tools" ] || sdk_tools="${sdk_root%/*}/darwin-aarch64/tools"

output=$1
include_dir="$sdk_root/AROS/Developer/include"
generated_include_dir="$sdk_root/gen/include"
posix_include_dir="$include_dir/aros/posixc"
stdc_include_dir="$include_dir/aros/stdc"
library_dir="$sdk_root/AROS/Developer/lib"
clang="$crosstools/bin/clang"

[ -x "$clang" ] || {
    echo "abi-probe-build result=FAIL reason=missing-clang path=$clang" >&2
    exit 1
}
[ -x "$sdk_tools/collect-aros" ] || {
    echo "abi-probe-build result=FAIL reason=missing-collect-aros path=$sdk_tools/collect-aros" >&2
    exit 1
}
[ -f "$library_dir/startup.o" ] || {
    echo "abi-probe-build result=FAIL reason=missing-sdk path=$sdk_root" >&2
    exit 1
}
[ -f "$posix_include_dir/time.h" ] && [ -f "$stdc_include_dir/stdint.h" ] || {
    echo "abi-probe-build result=FAIL reason=incomplete-sdk-headers path=$sdk_root" >&2
    exit 1
}

output_parent=$(dirname -- "$output")
mkdir -p "$output_parent"
temporary_output=$(mktemp "$output_parent/.abi-probe.XXXXXX")
trap 'find "$temporary_output" -depth -delete 2>/dev/null || true' \
    EXIT HUP INT TERM
export COMPILER_PATH="$sdk_tools:$crosstools/bin"

# Device qualification reuses the actual PCI, virtio and USB transports.
set --
if [ "$profile" = desktop-shutdown ]; then
    set -- -DVM_WORK_SHUTDOWN
fi
if [ "$profile" = desktop-network ]; then
    set -- -DVM_NETWORK_DESKTOP
fi
if [ "$profile" = desktop-clipboard ]; then
    set -- -DVM_CLIPBOARD_DESKTOP
fi
if [ "$profile" = stage6-transport ]; then
    set -- "${AROS_CORE_SOURCE:-$project_root/../aros-core}/workbench/tools/VMExchange/client.c"
fi
if [ "$profile" = platform ]; then
    set -- "$project_root/tests/command-startup.c"
fi
if [ "$profile" = pci ]; then
    set -- "$project_root/tests/virtio-block-queue.c" "$project_root/tests/virtio-device.c" "$project_root/tests/xhci-device.c" "$project_root/tests/virtio-network.c" "$project_root/tests/virtionet-device.c" "$project_root/tests/network-stack.c" "$project_root/tests/virtio-vsock.c" "$project_root/tests/vmbridge-device.c" "$project_root/tests/host-services.c" "$project_root/tests/clipboard-sync.c"
fi
if [ "$profile" = runtime-context ]; then
    set -- "$@" -O1 -g -fno-omit-frame-pointer -fno-optimize-sibling-calls -Wl,--no-undefined
else
    set -- "$@" -Wl,--allow-multiple-definition
fi
# Resolve CRT functions before native stubs. exec_regcall_stubs.o also exports
# library lifecycle names open/close; selecting it first binds POSIX clients to
# the wrong ABI even though the link has no undefined symbols.
"$clang" \
    --target=aarch64-unknown-aros \
    -mcmodel=large -fno-pic -fno-pie -femulated-tls \
    -O2 -Wall -Wextra -Werror \
    -I"${AROS_CORE_SOURCE:-$project_root/../aros-core}/arch/aarch64-apple/include" \
    -I"${AROS_CORE_SOURCE:-$project_root/../aros-core}/workbench/tools/VMExchange" \
    -I"${AROS_CORE_SOURCE:-$project_root/../aros-core}/rom/hidds/pci" \
    -I"${AROS_CORE_SOURCE:-$project_root/../aros-core}/rom/devs/virtio" \
    -I"${AROS_CORE_SOURCE:-$project_root/../aros-core}/rom/hidds/virtiogfx" \
    -isystem "$include_dir" -isystem "$generated_include_dir" \
    -isystem "$posix_include_dir" -isystem "$stdc_include_dir" \
    -nostartfiles -nodefaultlibs \
    -L"$library_dir" -L"$crosstools/lib/generic" \
    "$library_dir/startup.o" "$source_file" "$@" -o "$temporary_output" \
    -Wl,--start-group -lpthread -lposixc -lstdcio -lstdc \
    -ldos -lexec -laros -lautoinit -llibinit -lutility -lamiga -larossupport \
    -lclang_rt.builtins-aarch64 -Wl,--end-group

chmod 0644 "$temporary_output"
mv "$temporary_output" "$output"
trap - EXIT HUP INT TERM
digest=$(shasum -a 256 "$output" | awk '{print $1}')
bytes=$(wc -c <"$output" | tr -d ' ')
echo "abi-probe-build result=PASS profile=$profile path=$output bytes=$bytes sha256=$digest sdk=$sdk_root sdk_tools=$sdk_tools"
